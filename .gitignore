# ======================================================
# Godot 4+ specific ignores
# ======================================================
.godot/
.nomedia

# ======================================================
# Godot-specific ignores
# ======================================================
.import/
export.cfg
export_credentials.cfg
*.tmp

# ======================================================
# Mono-specific ignores
# ======================================================
.mono/
data_*/
mono_crash.*.json

# ======================================================
# Editor-specific
# ======================================================
.vscode/
.idea/

# ======================================================
# Exclude all asset files
# ======================================================

# 2D Textures
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Vector Graphics
*.svg
*.svgz

# 3D Models
*.glb
*.gltf

# Audio assets
*.mp4
*.wav

# Custom Fonts
*.ttf
*.otf

# ======================================================
# EXCEPTION: Placeholders and Base UI
# ======================================================
!shared/placeholders/**

# Rust
target/

# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicitly ensure code and config files use LF
*.rs text eol=lf
*.toml text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf

# Keep binary files raw
*.png binary
*.webp binary
*.gltf binary
*.bin binary
