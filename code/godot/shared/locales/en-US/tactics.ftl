
# =========================================================================================
# [SECTION] POSITIONS: The various positions available in the game
# =========================================================================================

name-pos-gk = Goalkeeper
    .short = GK
    .desc = The last line of defense, responsible for protecting the net and organizing the defensive line. They are the only player allowed to touch the ball with their hands in their own penalty area.
    .plural = Goalkeepers

name-pos-cb = Center Back
    .short = CB
    .desc = The central core of the defensive line, responsible for stopping attacks from the opponents and clearing the ball from the penalty area.
    .plural = Center Backs

name-pos-lb = Left Back
    .short = LB
    .desc = Operates on the left flank of the defense. Tasked with neutralzing wide attackers.
    .plural = Left Backs

name-pos-rb = Right Back
    .short = RB
    .desc = Operates on the right flank of the defense. Tasked with neutralzing wide attackers.
    .plural = Right Backs

name-pos-dm = Defensive Midfielder
    .short = DM
    .desc = Sits just ahead of the defensive line to intercept passes, break up opposition play, and initie counter attacks.
    .plural = Defensive Midfielders

name-pos-cm = Central Midfielder
    .short = CM
    .desc = The engine of the team, operating in the middle of the field. Responsible to linking defense and attack, dictating the temp, and controlling possesion.
    .plural = Central Midfielders

name-pos-am = Attacking Midfielder
    .short = AM
    .desc = Operates just ahead of the central midfield. Responsible for creating goal-scoring opportunities for the attackers. The creative outlet of the team.
    .plural = Attacking Midfielders

name-pos-lm = Left Midfielder
    .short = LM
    .desc = Operates on the left flank of the midfield. Balancing defensive duties with crossing and chance creation in the attack.
    .plural = Left Midfielders

name-pos-rm = Right Midfielder
    .short = RM
    .desc = Operates on the right flank of the midfield. Balancing defensive duties with crossing and chance creation in the attack.
    .plural = Right Midfielders

name-pos-cf = Center Forward
    .short = CF
    .desc = A versatile forward who often drops slightly to link up with the midfield, pull defenders out of position, and create space for the attackers.
    .plural = Center Forwards

name-pos-st = Striker
    .short = ST
    .desc = The focal point of the attack, often being the closest player to the opponents goal. Responsible primarily for scoring goals.
    .plural = Strikers

name-pos-rw = Right Winger
    .short = RW
    .desc = An advanced wide player attacking down the right flank, looking to beat defenses and provide crosses or shoot.
    .plural = Right Wingers

name-pos-lw = Left Winger
    .short = LW
    .desc = An advanced wide player attacking down the left flank, looking to beat defenses and provide crosses or shoot.
    .plural = Left Wingers
