# -prep-in term: Adds "in " or "in the " based on whether .article = true
-prep-in = { $country.article ->
   *[false] in { $country }
    [true]  in the { $country }
}

# -prep-from term: Adds "from " or "from the "
-prep-from = { $country.article ->
   *[false] from { $country }
    [true]  from the { $country }
}

# -prep-to term: Adds "to " or "to the "
-prep-to = { $country.article ->
   *[false] to { $country }
    [true]  to the { $country }
}


