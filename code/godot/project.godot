; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="People's Football Experience"
run/main_scene="res://scenes/main/node_2d.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
SceneManager="*res://scripts/autoloads/SceneManager.gd"
AssetManager="*res://scripts/autoloads/AssetManager.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"
DBManager="*res://scripts/autoloads/DBManager.gd"
ImGuiRoot="*uid://dugmpnsxaagba"
InputRouter="*uid://mnj6jfsnja40"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/borderless=true
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDScript_formatter/plugin.cfg", "res://addons/godot-sqlite/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/imgui-godot/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/spin_button/plugin.cfg")

